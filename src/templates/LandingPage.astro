---
import { Picture } from 'astro:assets';

import { getImage } from '../assets';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import Icon from '../components/Icon.astro';
import CtaBand from '../components/sections/CtaBand.astro';
import Fleet from '../components/sections/Fleet.astro';
import Faq from '../components/sections/Faq.astro';
import PopularRoutes from '../components/sections/PopularRoutes.astro';
import SectionHeading from '../components/SectionHeading.astro';
import TrustStrip from '../components/sections/TrustStrip.astro';
import BaseLayout from '../layouts/BaseLayout.astro';

import { isPlaceholder, whatsappHref } from '../config/site';
import type { Locale } from '../i18n/config';
import { pathFor, type PageKey } from '../i18n/routes';
import { getPage } from '../i18n/ui';
import { absoluteUrl, localeDefinition, useTranslations } from '../i18n/utils';
import { breadcrumbSchema, faqSchema, graph, serviceSchema } from '../lib/schema';

interface Props {
  locale: Locale;
  pageKey: PageKey;
}

const { locale, pageKey } = Astro.props;
const t = useTranslations(locale);
const page = getPage(locale, pageKey);

// Home > hub > page, so the breadcrumb matches the real structure of the
// site rather than flattening every page onto the home page.
const trail = [
  { name: t.common.home, path: pathFor('home', locale) },
  ...(page.hub
    ? [{ name: getPage(locale, page.hub).breadcrumb, path: pathFor(page.hub, locale) }]
    : []),
  { name: page.breadcrumb, path: pathFor(pageKey, locale) },
];

const canonical = absoluteUrl(pathFor(pageKey, locale), Astro.site);

const jsonLd = graph(
  breadcrumbSchema(
    trail.map((crumb) => ({
      name: crumb.name,
      url: absoluteUrl(crumb.path, Astro.site),
    })),
  ),
  page.serviceType
    ? serviceSchema({
        name: page.h1,
        description: page.description,
        serviceType: page.serviceType,
        url: canonical,
        language: localeDefinition(locale).hreflang,
      })
    : undefined,
  faqSchema(page.faq),
);

const waHref = whatsappHref(t.form.genericWhatsappMessage);
---

<BaseLayout
  pageKey={pageKey}
  locale={locale}
  title={page.title}
  description={page.description}
  jsonLd={jsonLd}
>
  <!-- Hero -->
  <section class="pt-5 md:pt-7">
    <div class="container-page">
      <Breadcrumbs locale={locale} trail={trail} />

      <div
        class="relative mt-4 isolate overflow-hidden rounded-[var(--radius-media)] bg-ink"
      >
        <Picture
          src={getImage(page.heroImage)}
          alt={page.heroImageAlt}
          formats={['avif', 'webp']}
          fallbackFormat="jpg"
          widths={[640, 960, 1280, 1800]}
          sizes="(min-width: 1280px) 1216px, (min-width: 768px) calc(100vw - 4rem), calc(100vw - 2.5rem)"
          loading="eager"
          decoding="async"
          fetchpriority="high"
          layout="full-width"
          class="absolute inset-0 h-full w-full object-cover"
        />
        <div
          class="absolute inset-0 bg-gradient-to-t from-black/80 via-black/62 to-black/58"
          aria-hidden="true"
        >
        </div>

        <div
          class="relative flex min-h-[22rem] flex-col items-center justify-center px-5 py-16 text-center sm:min-h-[26rem] sm:px-8 md:py-20 lg:min-h-[28rem]"
        >
          <h1
            class="max-w-4xl text-[2rem] leading-[1.1] text-white sm:text-[2.5rem] lg:text-[3rem]"
          >
            {page.h1}
          </h1>
          <span class="gold-rule mt-6" aria-hidden="true"></span>
          <p
            class="mt-6 max-w-2xl text-[1.0625rem] leading-relaxed text-white/85 sm:text-lg"
          >
            {page.lead}
          </p>
          <div class="mt-8 flex flex-col gap-3 sm:flex-row sm:gap-4">
            <a href={waHref} target="_blank" rel="noopener" class="btn btn-on-dark">
              <Icon name="whatsapp" size={18} />
              {t.common.bookOnWhatsapp}
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>

  {/* Route pages state the trip facts before anything else. */}
  {
    page.trip && (
      <section class="mt-12 lg:mt-14" aria-label={t.trip.heading}>
        <div class="container-page">
          <dl class="card grid grid-cols-2 gap-x-6 gap-y-5 p-6 sm:grid-cols-4 lg:p-7">
            {[
              { label: t.trip.duration, value: page.trip.duration },
              { label: t.trip.distance, value: page.trip.distance },
              { label: t.trip.vehicle, value: page.trip.vehicle },
              { label: t.trip.seats, value: page.trip.seats },
            ].map((fact) => (
              <div class="min-w-0">
                <dt class="text-[0.6875rem] font-semibold tracking-[0.14em] text-gold-ink uppercase">
                  {fact.label}
                </dt>
                <dd
                  class:list={[
                    'mt-1.5 leading-tight break-words',
                    isPlaceholder(fact.value)
                      ? 'text-sm text-muted'
                      : 'font-display text-[1.125rem] text-ink',
                  ]}
                >
                  {fact.value}
                </dd>
              </div>
            ))}
          </dl>
        </div>
      </section>
    )
  }

  {
    page.included.length > 0 && (
      <section class="mt-10 lg:mt-12">
        <div class="container-page">
          <div class="mx-auto max-w-3xl">
            <h2 class="text-[1.375rem] leading-snug text-ink">{t.trip.included}</h2>
            <span class="gold-rule mt-4" aria-hidden="true" />
            <ul class="mt-6 grid gap-3 sm:grid-cols-2">
              {page.included.map((item) => (
                <li class="flex items-start gap-2.5 text-[0.9375rem] text-ink">
                  <Icon name="check" size={18} class="mt-0.5 shrink-0 text-gold" />
                  {item}
                </li>
              ))}
            </ul>
          </div>
        </div>
      </section>
    )
  }

  <div class="mt-14 lg:mt-16">
    <TrustStrip locale={locale} />
  </div>

  <!-- Body -->
  {
    page.body.map((section, index) => (
      <section class:list={['section-y', index % 2 === 1 && 'bg-sand']}>
        <div class="container-page">
          <div class="mx-auto max-w-3xl">
            <h2 class="text-[1.75rem] leading-snug text-ink sm:text-[2rem]">
              {section.heading}
            </h2>
            <span class="gold-rule mt-5" aria-hidden="true" />

            {section.paragraphs.map((paragraph) => (
              <p class="mt-5 text-[1.0625rem] leading-relaxed text-muted">
                {paragraph}
              </p>
            ))}

            {section.bullets.length > 0 && (
              <ul class="mt-7 grid gap-3 sm:grid-cols-2">
                {section.bullets.map((bullet) => (
                  <li class="flex items-start gap-2.5 text-[0.9375rem] text-ink">
                    <Icon name="check" size={18} class="mt-0.5 shrink-0 text-gold" />
                    {bullet}
                  </li>
                ))}
              </ul>
            )}
          </div>
        </div>
      </section>
    ))
  }

  {
    page.routeIds.length > 0 && (
      <PopularRoutes
        locale={locale}
        routeIds={page.routeIds}
        tone={page.body.length % 2 === 1 ? 'paper' : 'sand'}
        id="routes"
      />
    )
  }

  {
    page.faq.length > 0 && (
      <Faq
        locale={locale}
        items={page.faq}
        tone={
          (page.body.length + (page.routeIds.length > 0 ? 1 : 0)) % 2 === 1
            ? 'paper'
            : 'sand'
        }
        id="faq"
      />
    )
  }

  {page.showFleet && <Fleet locale={locale} />}

  {/* Three related pages, and the way back up to the hub. */}
  {
    page.related.length > 0 && (
      <section class="section-y" aria-labelledby="related-heading">
        <div class="container-page">
          <SectionHeading heading={t.related.heading} id="related-heading" />
          <ul class="mx-auto mt-10 grid max-w-4xl gap-4 sm:grid-cols-3">
            {page.related.map((key) => (
              <li>
                <a
                  href={pathFor(key, locale)}
                  class="card group flex h-full flex-col justify-between gap-4 p-5 transition-colors hover:border-gold"
                >
                  <span class="font-display text-[1.0625rem] leading-snug text-ink">
                    {getPage(locale, key).breadcrumb}
                  </span>
                  <Icon
                    name="arrow-right"
                    size={18}
                    class="rtl-flip text-gold transition-transform duration-200 group-hover:translate-x-1"
                  />
                </a>
              </li>
            ))}
          </ul>

          {page.hub && (
            <p class="mt-8 text-center text-[0.9375rem]">
              <a
                href={pathFor(page.hub, locale)}
                class="font-semibold text-ink underline decoration-line underline-offset-4 transition-colors hover:decoration-gold"
              >
                {t.related.backToHub} {getPage(locale, page.hub).breadcrumb}
              </a>
            </p>
          )}
        </div>
      </section>
    )
  }

  <CtaBand locale={locale} />
</BaseLayout>
