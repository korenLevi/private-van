---
import CtaBand from '../components/sections/CtaBand.astro';
import Faq from '../components/sections/Faq.astro';
import Fleet from '../components/sections/Fleet.astro';
import Hero from '../components/sections/Hero.astro';
import HowItWorks from '../components/sections/HowItWorks.astro';
import PopularRoutes from '../components/sections/PopularRoutes.astro';
import RequestQuote from '../components/sections/RequestQuote.astro';
import Reviews from '../components/sections/Reviews.astro';
import Services from '../components/sections/Services.astro';
import TrustStrip from '../components/sections/TrustStrip.astro';
import Offerings from '../components/sections/Offerings.astro';
import BaseLayout from '../layouts/BaseLayout.astro';

import { SITE } from '../config/site';
import type { Locale } from '../i18n/config';
import { getPage } from '../i18n/ui';
import { pathFor } from '../i18n/routes';
import { absoluteUrl, localeDefinition, useTranslations } from '../i18n/utils';
import {
  graph,
  localBusinessSchema,
  taxiServiceSchema,
  websiteSchema,
} from '../lib/schema';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);
const page = getPage(locale, 'home');

const ogImageUrl = absoluteUrl(SITE.ogImage, Astro.site);
const logoUrl = absoluteUrl(SITE.logo, Astro.site);

/**
 * LocalBusiness and TaxiService describe the business; WebSite anchors this
 * language version. No FAQPage: the FAQ section is not rendered here, and
 * structured data has to describe what is actually on the page.
 * <Reviews locale={locale} />
 *   <PopularRoutes locale={locale} tone="paper" />
 *     <HowItWorks locale={locale} />
 *       <Fleet locale={locale} />
 *        <Faq locale={locale} />
 */
const canonical = absoluteUrl(pathFor('home', locale), Astro.site);

const jsonLd = graph(
  localBusinessSchema(t.schema.businessDescription, ogImageUrl, logoUrl),
  taxiServiceSchema(t.schema.businessDescription, t.schema.serviceType),
  websiteSchema(localeDefinition(locale).hreflang, canonical),
);
---

<BaseLayout
  pageKey="home"
  locale={locale}
  title={page.title}
  description={page.description}
  jsonLd={jsonLd}
>
  <Hero locale={locale} />
  <TrustStrip locale={locale} />
  <Services locale={locale} />
  <Offerings locale={locale} />
 
  
  <RequestQuote locale={locale} tone="paper" source="homepage-footer-form" />
  <CtaBand locale={locale} />
</BaseLayout>
