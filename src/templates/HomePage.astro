---
import CtaBand from '../components/sections/CtaBand.astro';
import Faq from '../components/sections/Faq.astro';
import Fleet from '../components/sections/Fleet.astro';
import Hero from '../components/sections/Hero.astro';
import HowItWorks from '../components/sections/HowItWorks.astro';
import HowItWorks from '../components/sections/Faq.astro';
import PopularRoutes from '../components/sections/PopularRoutes.astro';
import RequestQuote from '../components/sections/RequestQuote.astro';
import Fleet from '../components/sections/Fleet.astro';
import Reviews from '../components/sections/Reviews.astro';
import Services from '../components/sections/Services.astro';
import TrustStrip from '../components/sections/TrustStrip.astro';
import Offerings from '../components/sections/Offerings.astro';
import BaseLayout from '../layouts/BaseLayout.astro';

import { SITE } from '../config/site';
import type { Locale } from '../i18n/config';
import { getPage } from '../i18n/ui';
import { absoluteUrl, useTranslations } from '../i18n/utils';
import {
  faqSchema,
  graph,
  localBusinessSchema,
  taxiServiceSchema,
  websiteSchema,
} from '../lib/schema';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);
const page = getPage(locale, 'home');

const ogImageUrl = absoluteUrl(SITE.ogImage, Astro.site);

/**
 * LocalBusiness and TaxiService describe the business; WebSite anchors the
 * domain; FAQPage covers the questions further down this page. One @graph
 * rather than four script tags.
 * <Reviews locale={locale} />
 *   <PopularRoutes locale={locale} tone="paper" />
 *     <HowItWorks locale={locale} />
 *       <Fleet locale={locale} />
 *        <Faq locale={locale} />
 */
const jsonLd = graph(
  localBusinessSchema(t.schema.businessDescription, ogImageUrl),
  taxiServiceSchema(t.schema.businessDescription, t.schema.serviceType),
  websiteSchema(),
  faqSchema(t.faq.items),
);
---

<BaseLayout
  pageKey="home"
  locale={locale}
  title={page.title}
  description={page.description}
  jsonLd={jsonLd}
>
  <Hero locale={locale} />
  <TrustStrip locale={locale} />
  <Services locale={locale} />
  <Offerings locale={locale} />
 
  
  <RequestQuote locale={locale} tone="paper" source="homepage-footer-form" />
  <CtaBand locale={locale} />
</BaseLayout>
