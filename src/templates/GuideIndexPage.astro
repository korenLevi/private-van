---
/**
 * The guides index.
 *
 * Lists only the guides published in this language. A Hebrew guide about
 * wedding transport has no English twin on purpose, so the English index
 * simply does not mention it.
 */
import { Picture } from 'astro:assets';

import { getImage } from '../assets';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import Icon from '../components/Icon.astro';
import CtaBand from '../components/sections/CtaBand.astro';
import BaseLayout from '../layouts/BaseLayout.astro';

import type { Locale } from '../i18n/config';
import { guidesFor, pathFor } from '../i18n/routes';
import { getPage } from '../i18n/ui';
import { absoluteUrl, localeDefinition, useTranslations } from '../i18n/utils';
import { breadcrumbSchema, graph, itemListSchema } from '../lib/schema';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);
const page = getPage(locale, 'guidesIndex');

const guides = guidesFor(locale).map((key) => ({
  key,
  path: pathFor(key, locale),
  content: getPage(locale, key),
}));

const trail = [
  { name: t.common.home, path: pathFor('home', locale) },
  { name: page.breadcrumb, path: pathFor('guidesIndex', locale) },
];

const jsonLd = graph(
  breadcrumbSchema(
    trail.map((c) => ({ name: c.name, url: absoluteUrl(c.path, Astro.site) })),
  ),
  itemListSchema(
    guides.map((g) => ({
      name: g.content.h1,
      url: absoluteUrl(g.path, Astro.site),
    })),
  ),
);

const formatDate = (iso?: string) =>
  iso
    ? new Intl.DateTimeFormat(localeDefinition(locale).hreflang, {
        year: 'numeric',
        month: 'short',
        day: 'numeric',
      }).format(new Date(iso))
    : null;
---

<BaseLayout
  pageKey="guidesIndex"
  locale={locale}
  title={page.title}
  description={page.description}
  jsonLd={jsonLd}
>
  <section class="pt-6 pb-4 md:pt-8">
    <div class="container-page">
      <Breadcrumbs locale={locale} trail={trail} />

      <div class="mt-8 max-w-3xl">
        <p class="eyebrow">{t.guides.indexEyebrow}</p>
        <h1 class="mt-3 text-[2.125rem] leading-[1.1] sm:text-[2.75rem] lg:text-[3rem]">
          {page.h1}
        </h1>
        <span class="gold-rule mt-5" aria-hidden="true"></span>
        <p class="mt-6 text-[1.0625rem] leading-relaxed text-muted">{page.intro}</p>
      </div>
    </div>
  </section>

  <section class="pb-16 md:pb-20">
    <div class="container-page">
      <ul class="grid gap-6 md:grid-cols-2 lg:grid-cols-3">
        {
          guides.map((guide) => (
            <li class="card group flex flex-col overflow-hidden">
              <a href={guide.path} class="flex h-full flex-col">
                <Picture
                  src={getImage(guide.content.heroImage)}
                  alt={guide.content.heroImageAlt}
                  formats={['avif', 'webp']}
                  fallbackFormat="jpg"
                  widths={[320, 480, 640]}
                  sizes="(min-width: 1024px) 33vw, (min-width: 768px) 50vw, calc(100vw - 2.5rem)"
                  loading="lazy"
                  decoding="async"
                  layout="full-width"
                  class="aspect-[16/9] w-full object-cover"
                />

                <div class="flex flex-1 flex-col p-6">
                  {formatDate(guide.content.updated) && guide.content.updated && (
                    <p class="text-[0.6875rem] font-semibold tracking-[0.14em] text-gold-ink uppercase">
                      {t.guides.updatedLabel}{' '}
                      <time datetime={guide.content.updated}>
                        {formatDate(guide.content.updated)}
                      </time>
                    </p>
                  )}

                  <h2 class="mt-3 text-[1.25rem] leading-snug text-ink">
                    {guide.content.h1}
                  </h2>

                  <p class="mt-3 flex-1 text-[0.9375rem] leading-relaxed text-muted">
                    {guide.content.summary ?? guide.content.description}
                  </p>

                  <span class="mt-5 inline-flex items-center gap-2 text-[0.9375rem] font-semibold text-ink transition-colors group-hover:text-gold-ink">
                    {t.guides.readGuide}
                    <Icon
                      name="arrow-right"
                      size={17}
                      class="rtl-flip text-gold transition-transform duration-200 group-hover:translate-x-1"
                    />
                  </span>
                </div>
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <CtaBand locale={locale} />
</BaseLayout>
