---
/**
 * A guide.
 *
 * The shape is built for how these get read and quoted: the answer sits in a
 * summary block before anything else, the comparison table comes next
 * because that is the part people screenshot, and the body follows for
 * whoever is still reading. The update date is shown, not just put in the
 * schema, because a transport guide that might be five years old is worth
 * nothing to the reader.
 */
import { Picture } from 'astro:assets';

import { getImage } from '../assets';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import Icon from '../components/Icon.astro';
import SectionHeading from '../components/SectionHeading.astro';
import CtaBand from '../components/sections/CtaBand.astro';
import Faq from '../components/sections/Faq.astro';
import BaseLayout from '../layouts/BaseLayout.astro';

import { whatsappHref } from '../config/site';
import type { Locale } from '../i18n/config';
import { pathFor, type PageKey } from '../i18n/routes';
import { getPage } from '../i18n/ui';
import { absoluteUrl, localeDefinition, useTranslations } from '../i18n/utils';
import { articleSchema, breadcrumbSchema, faqSchema, graph } from '../lib/schema';

interface Props {
  locale: Locale;
  pageKey: PageKey;
}

const { locale, pageKey } = Astro.props;
const t = useTranslations(locale);
const page = getPage(locale, pageKey);
const canonical = absoluteUrl(pathFor(pageKey, locale), Astro.site);

const trail = [
  { name: t.common.home, path: pathFor('home', locale) },
  { name: getPage(locale, 'guidesIndex').breadcrumb, path: pathFor('guidesIndex', locale) },
  { name: page.breadcrumb, path: pathFor(pageKey, locale) },
];

const jsonLd = graph(
  breadcrumbSchema(
    trail.map((c) => ({ name: c.name, url: absoluteUrl(c.path, Astro.site) })),
  ),
  articleSchema({
    headline: page.h1,
    description: page.summary ?? page.description,
    url: canonical,
    imageUrl: absoluteUrl(`/${page.heroImage}`, Astro.site),
    updated: page.updated ?? '',
    language: localeDefinition(locale).hreflang,
  }),
  faqSchema(page.faq),
);

const dateLabel = page.updated
  ? new Intl.DateTimeFormat(localeDefinition(locale).hreflang, {
      year: 'numeric',
      month: 'long',
      day: 'numeric',
    }).format(new Date(page.updated))
  : null;
---

<BaseLayout
  pageKey={pageKey}
  locale={locale}
  title={page.title}
  description={page.description}
  jsonLd={jsonLd}
  ogType="article"
>
  <article>
    <section class="pt-6 md:pt-8">
      <div class="container-page">
        <Breadcrumbs locale={locale} trail={trail} />

        <div class="mx-auto mt-8 max-w-3xl">
          <p class="eyebrow">{t.guides.eyebrow}</p>
          <h1 class="mt-3 text-[2rem] leading-[1.12] sm:text-[2.5rem] lg:text-[2.75rem]">
            {page.h1}
          </h1>
          <span class="gold-rule mt-5" aria-hidden="true"></span>

          {
            dateLabel && page.updated && (
              <p class="mt-5 text-sm text-muted">
                {t.guides.updatedLabel}{' '}
                <time datetime={page.updated}>{dateLabel}</time>
              </p>
            )
          }
        </div>
      </div>
    </section>

    {/* The answer, before anything else on the page. */}
    {
      page.summary && (
        <section class="mt-8">
          <div class="container-page">
            <div class="mx-auto max-w-3xl rounded-[var(--radius-card)] border border-gold/40 bg-sand p-6 lg:p-7">
              <p class="text-[0.6875rem] font-semibold tracking-[0.14em] text-gold-ink uppercase">
                {t.guides.summaryLabel}
              </p>
              <p class="mt-3 text-[1.0625rem] leading-relaxed text-ink">{page.summary}</p>
            </div>
          </div>
        </section>
      )
    }

    <section class="mt-10 lg:mt-12">
      <div class="container-page">
        <div class="mx-auto max-w-3xl">
          <Picture
            src={getImage(page.heroImage)}
            alt={page.heroImageAlt}
            formats={['avif', 'webp']}
            fallbackFormat="jpg"
            widths={[480, 720, 960]}
            sizes="(min-width: 768px) 768px, calc(100vw - 2.5rem)"
            loading="eager"
            decoding="async"
            fetchpriority="high"
            layout="full-width"
            class="aspect-[16/9] w-full rounded-[var(--radius-card)] object-cover"
          />

          <p class="mt-7 text-[1.0625rem] leading-relaxed text-muted">{page.intro}</p>
        </div>
      </div>
    </section>

    {/* The table is the part readers screenshot and answer engines lift. */}
    {
      page.table && (
        <section class="mt-10 lg:mt-12">
          <div class="container-page">
            <div class="mx-auto max-w-3xl">
              <div class="overflow-x-auto rounded-[var(--radius-card)] border border-line">
                <table class="w-full border-collapse text-start text-[0.9375rem]">
                  <caption class="border-b border-line bg-sand px-5 py-4 text-start font-display text-[1.0625rem] text-ink">
                    {page.table.caption}
                  </caption>
                  <thead>
                    <tr class="border-b border-line bg-sand/60">
                      {page.table.columns.map((column) => (
                        <th
                          scope="col"
                          class="px-4 py-3 text-start text-[0.6875rem] font-semibold tracking-[0.1em] text-gold-ink uppercase"
                        >
                          {column}
                        </th>
                      ))}
                    </tr>
                  </thead>
                  <tbody>
                    {page.table.rows.map((row) => (
                      <tr class="border-b border-line last:border-0">
                        {row.map((cell, index) =>
                          index === 0 ? (
                            <th scope="row" class="px-4 py-3 text-start font-semibold text-ink">
                              {cell}
                            </th>
                          ) : (
                            <td class="px-4 py-3 text-muted">{cell}</td>
                          ),
                        )}
                      </tr>
                    ))}
                  </tbody>
                </table>
              </div>
              {page.table.note && (
                <p class="mt-3 text-sm text-muted">{page.table.note}</p>
              )}
            </div>
          </div>
        </section>
      )
    }

    {
      page.body.map((section) => (
        <section class="mt-10 lg:mt-12">
          <div class="container-page">
            <div class="mx-auto max-w-3xl">
              <h2 class="text-[1.5rem] leading-snug text-ink sm:text-[1.75rem]">
                {section.heading}
              </h2>
              <span class="gold-rule mt-4" aria-hidden="true" />
              {section.paragraphs.map((paragraph) => (
                <p class="mt-5 text-[1.0625rem] leading-relaxed text-muted">{paragraph}</p>
              ))}
              {section.bullets.length > 0 && (
                <ul class="mt-6 grid gap-3 sm:grid-cols-2">
                  {section.bullets.map((bullet) => (
                    <li class="flex items-start gap-2.5 text-[0.9375rem] text-ink">
                      <Icon name="check" size={18} class="mt-0.5 shrink-0 text-gold" />
                      {bullet}
                    </li>
                  ))}
                </ul>
              )}
            </div>
          </div>
        </section>
      ))
    }

    {/* The service page this guide exists to send people to. */}
    {
      page.leadsTo && page.leadsTo.length > 0 && (
        <section class="mt-12 lg:mt-14">
          <div class="container-page">
            <div class="mx-auto flex max-w-3xl flex-col gap-4 rounded-[var(--radius-card)] border border-line bg-sand p-6 sm:flex-row sm:items-center sm:justify-between lg:p-7">
              <div>
                <p class="font-display text-lg text-ink">{t.guides.helpHeading}</p>
                <p class="mt-1.5 text-[0.9375rem] text-muted">{t.guides.helpBody}</p>
              </div>
              <div class="flex shrink-0 flex-col gap-2 sm:flex-row">
                <a
                  href={whatsappHref(t.form.genericWhatsappMessage)}
                  target="_blank"
                  rel="noopener"
                  class="btn btn-primary"
                >
                  <Icon name="whatsapp" size={18} />
                  {t.common.bookOnWhatsapp}
                </a>
                <a href={pathFor(page.leadsTo[0], locale)} class="btn btn-outline">
                  {getPage(locale, page.leadsTo[0]).breadcrumb}
                </a>
              </div>
            </div>
          </div>
        </section>
      )
    }

    {page.faq.length > 0 && <Faq locale={locale} items={page.faq} tone="paper" id="faq" />}
  </article>

  {
    page.related.length > 0 && (
      <section class="section-y bg-sand" aria-labelledby="related-heading">
        <div class="container-page">
          <SectionHeading heading={t.related.heading} id="related-heading" />
          <ul class="mx-auto mt-10 grid max-w-4xl gap-4 sm:grid-cols-3">
            {page.related.map((key) => (
              <li>
                <a
                  href={pathFor(key, locale)}
                  class="card group flex h-full flex-col justify-between gap-4 p-5 transition-colors hover:border-gold"
                >
                  <span class="font-display text-[1.0625rem] leading-snug text-ink">
                    {getPage(locale, key).breadcrumb}
                  </span>
                  <Icon
                    name="arrow-right"
                    size={18}
                    class="rtl-flip text-gold transition-transform duration-200 group-hover:translate-x-1"
                  />
                </a>
              </li>
            ))}
          </ul>

          <p class="mt-8 text-center text-[0.9375rem]">
            <a
              href={pathFor('guidesIndex', locale)}
              class="font-semibold text-ink underline decoration-line underline-offset-4 transition-colors hover:decoration-gold"
            >
              {t.guides.allGuides}
            </a>
          </p>
        </div>
      </section>
    )
  }

  <CtaBand locale={locale} />
</BaseLayout>
