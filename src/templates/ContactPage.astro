---
import Breadcrumbs from '../components/Breadcrumbs.astro';
import Icon from '../components/Icon.astro';
import QuoteFormIsland from '../components/QuoteFormIsland.astro';
import CtaBand from '../components/sections/CtaBand.astro';
import TrustStrip from '../components/sections/TrustStrip.astro';
import BaseLayout from '../layouts/BaseLayout.astro';

import {
  BUSINESS,
  CONTACT,
  isPlaceholder,
  telHref,
  whatsappHref,
} from '../config/site';
import type { Locale } from '../i18n/config';
import { pathFor } from '../i18n/routes';
import { getPage } from '../i18n/ui';
import { absoluteUrl, useTranslations } from '../i18n/utils';
import { breadcrumbSchema, graph } from '../lib/schema';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);
const page = getPage(locale, 'contact');

const trail = [
  { name: t.common.home, path: pathFor('home', locale) },
  { name: page.breadcrumb, path: pathFor('contact', locale) },
];

const jsonLd = graph(
  breadcrumbSchema(
    trail.map((crumb) => ({
      name: crumb.name,
      url: absoluteUrl(crumb.path, Astro.site),
    })),
  ),
);

const waHref = whatsappHref(t.form.genericWhatsappMessage);
const showHours = !isPlaceholder(BUSINESS.hoursText);

const methods = [
  {
    icon: 'whatsapp' as const,
    label: t.footer.whatsappLabel,
    value: CONTACT.phoneDisplay,
    href: waHref,
    isPhone: true,
    external: true,
    note: t.common.messageOnWhatsapp,
  },
  {
    icon: 'phone' as const,
    label: t.footer.phoneLabel,
    value: CONTACT.phoneDisplay,
    href: telHref,
    isPhone: true,
    external: false,
    note: t.common.callUs,
  },
  {
    icon: 'mail' as const,
    label: t.footer.emailLabel,
    value: CONTACT.email,
    href: `mailto:${CONTACT.email}`,
    isPhone: false,
    external: false,
    note: '',
  },
];
---

<BaseLayout
  pageKey="contact"
  locale={locale}
  title={page.title}
  description={page.description}
  jsonLd={jsonLd}
>
  <section class="pt-6 pb-4 md:pt-8">
    <div class="container-page">
      <Breadcrumbs locale={locale} trail={trail} />

      <div class="mt-8 max-w-3xl">
        <p class="eyebrow">{page.breadcrumb}</p>
        <h1 class="mt-3 text-[2.125rem] leading-[1.1] sm:text-[2.75rem] lg:text-[3rem]">
          {page.h1}
        </h1>
        <span class="gold-rule mt-5" aria-hidden="true"></span>
        <p class="mt-6 text-[1.0625rem] leading-relaxed text-muted">{page.intro}</p>
      </div>
    </div>
  </section>

  <section class="pb-16 md:pb-20">
    <div class="container-page">
      <div class="grid gap-6 lg:grid-cols-[1fr_1.35fr] lg:gap-8">
        <!-- Ways to reach us -->
        <div class="flex flex-col gap-4">
          <ul class="flex flex-col gap-4">
            {
              methods.map((method) => (
                <li>
                  <a
                    href={method.href}
                    target={method.external ? '_blank' : undefined}
                    rel={method.external ? 'noopener' : undefined}
                    class="card flex items-start gap-4 p-5 transition-colors hover:border-gold lg:p-6"
                  >
                    <span class="mt-0.5 flex h-11 w-11 shrink-0 items-center justify-center rounded-full bg-sand text-gold">
                      <Icon name={method.icon} size={21} />
                    </span>
                    <span class="min-w-0">
                      <span class="block text-[0.6875rem] font-semibold tracking-[0.14em] text-gold-ink uppercase">
                        {method.label}
                      </span>
                      <span
                        class:list={[
                          'mt-1 block break-words font-display text-[1.125rem] text-ink',
                          method.isPhone && 'ltr-embed',
                        ]}
                      >
                        {method.value}
                      </span>
                      {method.note && (
                        <span class="mt-0.5 block text-sm text-muted">
                          {method.note}
                        </span>
                      )}
                    </span>
                  </a>
                </li>
              ))
            }
          </ul>

          {
            showHours && (
              <div class="card p-5 lg:p-6">
                <h2 class="text-[0.6875rem] font-semibold tracking-[0.14em] text-gold-ink uppercase">
                  {t.footer.hoursHeading}
                </h2>
                <p class="mt-2 text-[0.9375rem] text-muted">{BUSINESS.hoursText}</p>
              </div>
            )
          }

          <div class="card p-5 lg:p-6">
            <h2 class="text-[0.6875rem] font-semibold tracking-[0.14em] text-gold-ink uppercase">
              {t.footer.serviceAreaHeading}
            </h2>
            <p class="mt-2 text-[0.9375rem] leading-relaxed text-muted">
              {t.footer.serviceArea}
            </p>
          </div>
        </div>

        <!-- Quote form -->
        <div class="card p-6 lg:p-8">
          <QuoteFormIsland
            locale={locale}
            variant="card"
            contactFields={true}
            source="contact-page"
            hydrate="visible"
          />
        </div>
      </div>
    </div>
  </section>

  <TrustStrip locale={locale} />

  {
    page.body.map((section) => (
      <section class="section-y">
        <div class="container-page">
          <div class="mx-auto max-w-3xl">
            <h2 class="text-[1.75rem] leading-snug text-ink sm:text-[2rem]">
              {section.heading}
            </h2>
            <span class="gold-rule mt-5" aria-hidden="true" />
            {section.paragraphs.map((paragraph) => (
              <p class="mt-5 text-[1.0625rem] leading-relaxed text-muted">
                {paragraph}
              </p>
            ))}
          </div>
        </div>
      </section>
    ))
  }

  <CtaBand locale={locale} />
</BaseLayout>
