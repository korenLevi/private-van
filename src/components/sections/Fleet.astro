---
import { Picture } from 'astro:assets';

import { getImage } from '../../assets';
import { MEDIA, isPlaceholder } from '../../config/site';
import type { Locale } from '../../i18n/config';
import { useTranslations } from '../../i18n/utils';
import Icon from '../Icon.astro';
import LiteYouTube from '../LiteYouTube.astro';
import SectionHeading from '../SectionHeading.astro';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);

const videos = MEDIA.fleetVideos;
const gallery = t.fleet.gallery;
---

<section id="fleet" class="section-y bg-sand">
  <div class="container-page">
    <SectionHeading
      eyebrow={t.fleet.eyebrow}
      heading={t.fleet.heading}
      intro={t.fleet.intro}
    />

    {/*
      Videos first. Each plays through a facade — a thumbnail with a play
      button — so no YouTube iframe, script or cookie loads until someone
      clicks. The block renders only once MEDIA.fleetVideos has an id in it.
    */}
    {
      videos.length > 0 && (
        <div class="mt-12 lg:mt-14">
          <h3 class="mb-5 text-center font-display text-[1.5rem] text-ink">
            {t.fleet.videoHeading}
          </h3>
          {/*
            The clips are phone-shot reels, so each plays in a 9:16 portrait
            frame capped at a phone-ish width — one centred, or two abreast.
          */}
          <div
            class:list={[
              'mx-auto grid gap-4 lg:gap-5',
              videos.length === 1 ? 'max-w-[20rem]' : 'max-w-2xl grid-cols-2',
            ]}
          >
            {videos.map((id, i) => (
              <LiteYouTube
                videoId={id}
                aspect="short"
                title={`${t.fleet.videoHeading} ${videos.length > 1 ? i + 1 : ''}`.trim()}
                thumbnailAlt={t.fleet.videoAlt}
                playLabel={t.fleet.videoCta}
              />
            ))}
          </div>
        </div>
      )
    }

    {/*
      Photo gallery. The real photos are portrait phone shots, so every tile
      is a 3:4 card with the image cropped to fill — four across on a wide
      screen, two up on a phone, and it adapts to however many photos the
      dictionary lists.
    */}
    <ul
      class:list={[
        'grid grid-cols-2 gap-4 lg:grid-cols-4 lg:gap-5',
        videos.length > 0 ? 'mt-8 lg:mt-10' : 'mt-12 lg:mt-14',
      ]}
    >
      {
        gallery.map((photo, i) => (
          <li class="overflow-hidden rounded-[var(--radius-card)]">
            <Picture
              src={getImage(photo.image)}
              alt={photo.alt}
              formats={['avif', 'webp']}
              fallbackFormat="jpg"
              widths={[360, 540, 720]}
              sizes="(min-width: 1024px) 25vw, calc(50vw - 1.5rem)"
              loading={i < 2 ? 'eager' : 'lazy'}
              decoding="async"
              layout="full-width"
              class="aspect-[3/4] h-full w-full object-cover transition-transform duration-500 hover:scale-[1.03]"
            />
          </li>
        ))
      }
    </ul>

    <!-- Specs and amenities -->
    <div class="mt-10 grid gap-6 lg:grid-cols-[1.2fr_1fr] lg:gap-8">
      <dl class="card grid grid-cols-2 gap-x-6 gap-y-5 p-6 sm:grid-cols-4 lg:p-7">
        {
          t.fleet.specs.map((spec) => (
            <div class="min-w-0">
              <dt class="text-[0.6875rem] font-semibold tracking-[0.14em] text-gold-ink uppercase">
                {spec.label}
              </dt>
              <dd
                class:list={[
                  'mt-1.5 leading-tight break-words',
                  isPlaceholder(spec.value)
                    ? 'text-sm text-muted'
                    : 'font-display text-[1.125rem] text-ink',
                ]}
              >
                {spec.value}
              </dd>
            </div>
          ))
        }
      </dl>

      <div class="card p-6 lg:p-7">
        <h3 class="text-[0.6875rem] font-semibold tracking-[0.14em] text-gold-ink uppercase">
          {t.fleet.amenitiesHeading}
        </h3>
        <ul class="mt-4 grid grid-cols-1 gap-2.5 sm:grid-cols-2 lg:grid-cols-1">
          {
            t.fleet.amenities.map((amenity) => (
              <li class="flex items-start gap-2.5 text-[0.9375rem] text-muted">
                <Icon name="check" size={17} class="mt-1 shrink-0 text-gold" />
                {amenity}
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </div>
</section>
