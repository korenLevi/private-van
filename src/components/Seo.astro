---
/**
 * Every tag search engines and social networks read, in one place.
 */
import { SITE } from '../config/site';
import { LOCALES, localeDefinition, type Locale } from '../i18n/config';
import { absoluteUrl, hreflangLinks } from '../i18n/utils';

interface Props {
  title: string;
  description: string;
  /** Site-relative path of this page, e.g. "/contact". */
  path: string;
  locale: Locale;
  /** Every locale variant of this page, for hreflang. */
  alternates: Array<{ locale: Locale; path: string }>;
  /** Site-relative or absolute image URL for the social card. */
  ogImage?: string;
  ogType?: 'website' | 'article';
  noindex?: boolean;
}

const {
  title,
  description,
  path,
  locale,
  alternates,
  ogImage = SITE.ogImage,
  ogType = 'website',
  noindex = false,
} = Astro.props;

const canonical = absoluteUrl(path, Astro.site);
const imageUrl = ogImage.startsWith('http')
  ? ogImage
  : absoluteUrl(ogImage, Astro.site);
const alternateLinks = hreflangLinks(alternates, Astro.site);
const ogLocale = localeDefinition(locale).ogLocale;
---

<title>{title}</title>
<meta name="description" content={description} />
{/* A noindex page (the 404, preview deploys) names no canonical URL. */}
{!noindex && <link rel="canonical" href={canonical} />}

{
  noindex ? (
    <meta name="robots" content="noindex, nofollow" />
  ) : (
    <meta
      name="robots"
      content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1"
    />
  )
}

{/* hreflang — emitted even with one language so adding the next needs no change */}
{
  !noindex &&
    alternateLinks.map((link) => (
    <link rel="alternate" hreflang={link.hreflang} href={link.href} />
  ))
}

{/* Open Graph */}
<meta property="og:type" content={ogType} />
<meta property="og:site_name" content={SITE.name} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
{!noindex && <meta property="og:url" content={canonical} />}
<meta property="og:image" content={imageUrl} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:image:alt" content={SITE.ogImageAlt} />
<meta property="og:locale" content={ogLocale} />
{
  LOCALES.filter((l) => l.code !== locale).map((l) => (
    <meta property="og:locale:alternate" content={l.ogLocale} />
  ))
}

{/* Twitter */}
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={imageUrl} />
<meta name="twitter:image:alt" content={SITE.ogImageAlt} />
{
  SITE.twitterHandle && (
    <>
      <meta name="twitter:site" content={SITE.twitterHandle} />
      <meta name="twitter:creator" content={SITE.twitterHandle} />
    </>
  )
}
