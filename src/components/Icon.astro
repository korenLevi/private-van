---
/**
 * Inline SVG icons. Inlining avoids a sprite request and keeps the icons
 * recolourable with `currentColor`.
 *
 * Decorative by default (aria-hidden). Pass a `title` only when the icon is
 * the sole content of a control and carries the meaning on its own.
 */
export type IconName =
  | 'van'
  | 'plane'
  | 'clock'
  | 'pin'
  | 'check'
  | 'star'
  | 'arrow-right'
  | 'phone'
  | 'whatsapp'
  | 'menu'
  | 'close'
  | 'play'
  | 'chevron-down'
  | 'mail'
  | 'calendar'
  | 'users'
  | 'route';

interface Props {
  name: IconName;
  size?: number;
  class?: string;
  title?: string;
  strokeWidth?: number;
}

const {
  name,
  size = 24,
  class: className = '',
  title,
  strokeWidth = 1.5,
} = Astro.props;

/** Stroked outlines unless noted. All drawn on a 24×24 grid. */
const STROKE: Partial<Record<IconName, string>> = {
  van: '<path d="M2 16.5V9.8a1.8 1.8 0 0 1 1.8-1.8h8.9a1.8 1.8 0 0 1 1.5.8l2.6 3.9h2.4A2.8 2.8 0 0 1 22 15.5v1a1 1 0 0 1-1 1h-1.2"/><path d="M8.8 17.5h5.6"/><path d="M2 17.5h1.2"/><circle cx="6" cy="17.5" r="2"/><circle cx="17.2" cy="17.5" r="2"/><path d="M14 8v4.7h4.8"/>',
  plane:
    '<path d="M10.2 13.8 3 11.5a.6.6 0 0 1-.1-1.1l1.7-1a.9.9 0 0 1 .8 0l3.3 1.2 4.4-3.1-3.3-3.8a.5.5 0 0 1 .3-.8l1.6-.3a1 1 0 0 1 .8.2l5 3.7 3.2-1.2a1.8 1.8 0 0 1 1.5 3.2l-2.9 1.9-1 6a1 1 0 0 1-.5.7l-1.4.7a.5.5 0 0 1-.7-.5l.2-5-4.4 3.1v3.6a.9.9 0 0 1-.4.7l-1.5 1a.6.6 0 0 1-1-.4Z"/>',
  clock: '<circle cx="12" cy="12" r="9"/><path d="M12 7.2V12l3.2 1.9"/>',
  pin: '<path d="M12 21.5s7-5.8 7-11a7 7 0 1 0-14 0c0 5.2 7 11 7 11Z"/><circle cx="12" cy="10.4" r="2.6"/>',
  check: '<path d="m4.5 12.5 4.8 4.8L19.5 7.1"/>',
  'arrow-right': '<path d="M4 12h15.5"/><path d="m13.5 5.8 6.2 6.2-6.2 6.2"/>',
  phone:
    '<path d="M8.3 3.5 10 7.1a1 1 0 0 1-.2 1.2L8 10a13.4 13.4 0 0 0 6 6l1.7-1.8a1 1 0 0 1 1.2-.2l3.6 1.7a1 1 0 0 1 .5 1.2l-.7 2.3a1.6 1.6 0 0 1-1.7 1.1C11.5 19.8 4.2 12.5 3.2 5.4A1.6 1.6 0 0 1 4.3 3.7l2.3-.7a1 1 0 0 1 1.7.5Z"/>',
  menu: '<path d="M3.5 7h17"/><path d="M3.5 12h17"/><path d="M3.5 17h17"/>',
  close: '<path d="m5.5 5.5 13 13"/><path d="m18.5 5.5-13 13"/>',
  'chevron-down': '<path d="m5.5 9 6.5 6.5L18.5 9"/>',
  mail: '<rect x="2.8" y="5" width="18.4" height="14" rx="2.2"/><path d="m3.5 7 7.4 5.4a2 2 0 0 0 2.2 0L20.5 7"/>',
  calendar:
    '<rect x="3.2" y="5.2" width="17.6" height="15.6" rx="2.2"/><path d="M3.2 10h17.6"/><path d="M8 3v4"/><path d="M16 3v4"/>',
  users:
    '<circle cx="9.5" cy="8.2" r="3.4"/><path d="M3 20.2a6.5 6.5 0 0 1 13 0"/><path d="M16.2 5.2a3.4 3.4 0 0 1 0 6.6"/><path d="M18 14.4a6.5 6.5 0 0 1 3 5.8"/>',
  route:
    '<circle cx="6" cy="6" r="2.6"/><circle cx="18" cy="18" r="2.6"/><path d="M8.6 6H14a3.4 3.4 0 0 1 0 6.8h-4a3.4 3.4 0 0 0 0 6.8h5.4"/>',
};

/** Filled shapes. */
const FILL: Partial<Record<IconName, string>> = {
  star: '<path d="m12 2.6 2.9 5.9 6.5.9-4.7 4.6 1.1 6.5-5.8-3-5.8 3 1.1-6.5L2.6 9.4l6.5-.9Z"/>',
  play: '<path d="M8 5.2v13.6a.8.8 0 0 0 1.2.7l11-6.8a.8.8 0 0 0 0-1.4l-11-6.8A.8.8 0 0 0 8 5.2Z"/>',
  whatsapp:
    '<path d="M12.04 2A9.9 9.9 0 0 0 3.6 17.07L2.05 22l5.07-1.5A9.9 9.9 0 1 0 12.04 2Zm0 1.8a8.1 8.1 0 1 1-4.13 15.07l-.3-.18-3 .89.9-2.93-.2-.31A8.1 8.1 0 0 1 12.05 3.8Zm-3 3.83c-.16 0-.42.06-.64.3-.22.24-.85.83-.85 2.02 0 1.2.87 2.35.99 2.51.12.16 1.7 2.7 4.18 3.68 2.06.81 2.48.65 2.93.61.45-.04 1.44-.59 1.65-1.16.2-.57.2-1.05.14-1.16-.06-.1-.22-.16-.46-.28-.24-.12-1.44-.71-1.66-.79-.22-.08-.38-.12-.54.12-.16.24-.62.79-.76.95-.14.16-.28.18-.52.06-.24-.12-1.02-.38-1.95-1.2-.72-.64-1.2-1.43-1.34-1.67-.14-.24-.02-.37.1-.49.11-.11.24-.28.36-.42.12-.14.16-.24.24-.4.08-.16.04-.3-.02-.42-.06-.12-.53-1.31-.74-1.79-.19-.45-.39-.39-.53-.4h-.45Z"/>',
};

const isFilled = name in FILL;
const body = isFilled ? FILL[name] : STROKE[name];
const decorative = !title;
---

<svg
  xmlns="http://www.w3.org/2000/svg"
  viewBox="0 0 24 24"
  width={size}
  height={size}
  class={className}
  fill={isFilled ? 'currentColor' : 'none'}
  stroke={isFilled ? 'none' : 'currentColor'}
  stroke-width={isFilled ? undefined : strokeWidth}
  stroke-linecap={isFilled ? undefined : 'round'}
  stroke-linejoin={isFilled ? undefined : 'round'}
  role={decorative ? 'presentation' : 'img'}
  aria-hidden={decorative ? 'true' : undefined}
  aria-label={title}
  focusable="false"
>
  <Fragment set:html={body} />
</svg>
