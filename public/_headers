# Cloudflare Pages header rules.
# https://developers.cloudflare.com/pages/configuration/headers/

# Astro fingerprints these filenames, so they can be cached forever.
/_astro/*
  Cache-Control: public, max-age=31536000, immutable

# Self-hosted font files are fingerprinted too.
/_astro/fonts/*
  Cache-Control: public, max-age=31536000, immutable

# Hero video and the social card are stable but replaceable.
/media/*
  Cache-Control: public, max-age=2592000
/og-default.jpg
  Cache-Control: public, max-age=2592000

# Quote submissions must never be cached.
/api/*
  Cache-Control: no-store

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: SAMEORIGIN
  Permissions-Policy: geolocation=(), microphone=(), camera=(), interest-cohort=()
